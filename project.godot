; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Apple Garden Prototype"
run/main_scene="res://scenes/StartScreen.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")

[autoload]

World="*res://scripts/WorldRegistry.cs"
PlayerState="*res://scripts/PlayerState.cs"

[display]

; viewport_width/height is the fixed DESIGN resolution — every anchor,
; offset, and font size in the UI, and every world-space coordinate via
; Main.cs's AttachFollowCamera() zoom, is sized relative to this.
; stretch/mode "canvas_items" is what makes the actual window (mode=2,
; maximized — fills whatever screen it's on, high-DPI or not) uniformly
; scale that fixed design up to fit, instead of Godot's default
; "disabled" stretch, which just matches the viewport 1:1 to window size
; with no scaling at all — the window can get bigger without anything ON
; SCREEN getting bigger. A SMALLER design resolution stretched to the
; SAME physical window is a LARGER scale factor, which is the whole
; mechanism this leans on. Went from 1500x1150 -> 1050x800 (too big) ->
; 1250x950 (overcorrected, too small) -> here: splitting the difference.
window/size/viewport_width=1150
window/size/viewport_height=880
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="OpenRPG"

[rendering]

renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.75, 0.82, 0.6, 1)
